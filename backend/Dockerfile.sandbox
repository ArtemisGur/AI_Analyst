FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir . && addgroup --system sandbox && adduser --system --ingroup sandbox sandbox
CMD ["sh", "-c", "chown sandbox:sandbox /run/ai-analyst && exec su sandbox -s /bin/sh -c 'python -m app.agent.sandbox_server'"]
